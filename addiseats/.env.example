# Required for signed sessions in production. Replace with a unique random secret.
AUTH_SECRET=replace-with-a-random-32-byte-hex-secret
# Optional Google Identity Services OAuth 2.0 Web client ID (never put the client secret here).
GOOGLE_CLIENT_ID=
# Do not configure GOOGLE_CLIENT_SECRET; Google Identity Services ID-token sign-in does not need it.
# Optional canonical origin for metadata, sitemaps, and robots.txt.
# Vercel deployment domains are detected automatically when this is blank.
NEXT_PUBLIC_SITE_URL=
# VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL are platform-managed variables;
# Vercel supplies them automatically when available.